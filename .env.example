# ==============================================================================
# Environment Configuration Template for Fuzzy-Evolutionary ICU Pipeline
# Copy this file to .env and adjust variables as required for deployment.
# ==============================================================================

# Server Network Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG_MODE=false
LOG_LEVEL=info

# Real-Time ICU Signal Pipeline Parameters
DEFAULT_FS=250                      # Default ECG sensor sampling frequency (Hz)
STREAM_WINDOW_SAMPLES=1000          # Sliding analysis window length (samples, 4.0 s at 250 Hz)
STREAM_CHUNK_SAMPLES=25             # Real-time hop size (samples, 100 ms at 250 Hz)
BUFFER_CAPACITY_SAMPLES=1500        # Circular streaming buffer length (samples, fixed 6000 bytes / 6 KB)
EMERGENCY_LATENCY_BUDGET_S=3.0      # Hard real-time lethal arrhythmia alert budget (seconds)

# Baseline & Detector Default Optimization Hyperparameters
DEFAULT_BW=200                      # Moving-average baseline removal window size
DEFAULT_SM=5                        # Pre-differentiation smoothing filter window size
DEFAULT_TH=0.30                     # QRS adaptive integration energy threshold factor
DEFAULT_MW=25                       # Moving window integration width (samples)

# Genetic Algorithm Parameters
GA_POPULATION_SIZE=14               # Swarm / population individual count
GA_GENERATIONS=20                   # Optimization generations
GA_MUTATION_PROBABILITY=0.30        # Gaussian perturbation probability
GA_ELITISM_COUNT=1                  # Number of elite solutions preserved across generations

# CORS & Deployment
ALLOWED_ORIGINS=*
ENVIRONMENT=production
